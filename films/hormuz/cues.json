[
 {
  "id": "l01",
  "t0": 1.6,
  "t1": 4.78,
  "text": "海峡里的一艘船，长约 320 米。"
 },
 {
  "id": "l02",
  "t0": 4.9,
  "t1": 9.262,
  "text": "这是超大型油轮的尺寸：满载约 200 万桶原油。"
 },
 {
  "id": "l03",
  "t0": 9.4,
  "t1": 13.743,
  "text": "每天经过这里的石油，能装满约 10 艘这样的船。"
 },
 {
  "id": "l04",
  "t0": 15.6,
  "t1": 18.145,
  "text": "它们都要穿过同一扇门："
 },
 {
  "id": "l05",
  "t0": 18.4,
  "t1": 20.2,
  "text": "霍尔木兹海峡。"
 },
 {
  "id": "l06",
  "t0": 23.6,
  "t1": 27.722,
  "text": "海峡最窄处，在大昆岛和拉腊克岛之间，"
 },
 {
  "id": "l07",
  "t0": 29.2,
  "t1": 31.353,
  "text": "宽 38.6 公里。"
 },
 {
  "id": "l08",
  "t0": 36.4,
  "t1": 38.916,
  "text": "但大船不能随意通行。"
 },
 {
  "id": "l09",
  "t0": 39.2,
  "t1": 42.174,
  "text": "进港、出港，各有一条航道，"
 },
 {
  "id": "l10",
  "t0": 42.4,
  "t1": 44.774,
  "text": "每条只有约 3 公里宽。"
 },
 {
  "id": "l11",
  "t0": 48.3,
  "t1": 52.986,
  "text": "2024 年，平均每天 2000 万桶石油从这里通过，"
 },
 {
  "id": "l12",
  "t0": 53.4,
  "t1": 56.384,
  "text": "约占全球石油消费的五分之一。"
 },
 {
  "id": "l13",
  "t0": 57.8,
  "t1": 61.864,
  "text": "全球约五分之一的液化天然气，也走这条路。"
 },
 {
  "id": "l14",
  "t0": 62,
  "t1": 63.8,
  "text": "有没有别的路？"
 },
 {
  "id": "l15",
  "t0": 64.2,
  "t1": 68.107,
  "text": "沙特和阿联酋修了绕开海峡的输油管道。"
 },
 {
  "id": "l16",
  "t0": 69.4,
  "t1": 72.48,
  "text": "可一旦海峡被封，管道还能多运的"
 },
 {
  "id": "l17",
  "t0": 72.6,
  "t1": 77.13,
  "text": "只有每天约 260 万桶，约为平时的 13%。"
 },
 {
  "id": "l18",
  "t0": 83.6,
  "t1": 87.711,
  "text": "穿过海峡的原油，84% 运往亚洲。"
 },
 {
  "id": "l19",
  "t0": 89.4,
  "t1": 94.025,
  "text": "中国、印度、日本、韩国，是最大的买家。"
 },
 {
  "id": "l20",
  "t0": 95.6,
  "t1": 98.108,
  "text": "从这里看，它只是一个点。"
 },
 {
  "id": "l21",
  "t0": 99,
  "t1": 102.881,
  "text": "可全世界五分之一的石油，系在这一个点上。"
 }
]