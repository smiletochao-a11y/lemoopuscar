 "LINES": [
  {
   "id": "v01",
   "t": 0.3,
   "zh": "755年冬天，华清池。"
  },
  {
   "id": "v02",
   "t": 3,
   "zh": "她不知道，自己只剩两百多天。"
  },
  {
   "id": "v03",
   "t": 5.8,
   "zh": "那年冬天，唐玄宗照例带她来骊山泡温泉。"
  },
  {
   "id": "v04",
   "t": 11.6,
   "zh": "春寒赐浴华清池，温泉水滑洗凝脂。"
  },
  {
   "id": "v05",
   "t": 18.2,
   "zh": "有歌，有舞，有一年里最暖的水。"
  },
  {
   "id": "v06",
   "t": 23.4,
   "zh": "她看不见的是，北边，一匹快马正在路上。"
  },
  {
   "id": "v07",
   "t": 34.6,
   "zh": "天宝十四载十一月，"
  },
  {
   "id": "v08",
   "t": 37.4,
   "zh": "安禄山起兵的消息，送到了华清宫。"
  },
  {
   "id": "v09",
   "t": 43.8,
   "zh": "热气散了。"
  },
  {
   "id": "v10",
   "t": 48.4,
   "zh": "第二年夏天，长安失守，他们一路向西。"
  },
  {
   "id": "v11",
   "t": 54.4,
   "zh": "马嵬坡。"
  },
  {
   "id": "v12",
   "t": 57.6,
   "zh": "后来的浪漫，都是别人写的。"
  },
  {
   "id": "v13",
   "t": 60.2,
   "zh": "写“温泉水滑洗凝脂”的白居易，在她死后十六年才出生。"
  },
  {
   "id": "v14",
   "t": 65.6,
   "zh": "你记住的杨贵妃，是她本人，还是诗里的她？"
  }
 ]
}