[
 {
  "id": "v01",
  "t0": 0.3,
  "t1": 2.9,
  "text": "755年冬天，华清池。"
 },
 {
  "id": "v02",
  "t0": 3,
  "t1": 5.7,
  "text": "她不知道，自己只剩两百多天。"
 },
 {
  "id": "v03",
  "t0": 5.8,
  "t1": 9.75,
  "text": "那年冬天，唐玄宗照例带她来骊山泡温泉。"
 },
 {
  "id": "v04",
  "t0": 11.6,
  "t1": 16.7,
  "text": "春寒赐浴华清池，温泉水滑洗凝脂。"
 },
 {
  "id": "v05",
  "t0": 18.2,
  "t1": 21.733,
  "text": "有歌，有舞，有一年里最暖的水。"
 },
 {
  "id": "v06",
  "t0": 23.4,
  "t1": 27.455,
  "text": "她看不见的是，北边，一匹快马正在路上。"
 },
 {
  "id": "v07",
  "t0": 34.6,
  "t1": 36.768,
  "text": "天宝十四载十一月，"
 },
 {
  "id": "v08",
  "t0": 37.4,
  "t1": 40.738,
  "text": "安禄山起兵的消息，送到了华清宫。"
 },
 {
  "id": "v09",
  "t0": 43.8,
  "t1": 45.6,
  "text": "热气散了。"
 },
 {
  "id": "v10",
  "t0": 48.4,
  "t1": 51.973,
  "text": "第二年夏天，长安失守，他们一路向西。"
 },
 {
  "id": "v11",
  "t0": 54.4,
  "t1": 56.248,
  "text": "马嵬坡。"
 },
 {
  "id": "v12",
  "t0": 57.6,
  "t1": 59.971,
  "text": "后来的浪漫，都是别人写的。"
 },
 {
  "id": "v13",
  "t0": 60.2,
  "t1": 65.341,
  "text": "写“温泉水滑洗凝脂”的白居易，在她死后十六年才出生。"
 },
 {
  "id": "v14",
  "t0": 65.6,
  "t1": 69.259,
  "text": "你记住的杨贵妃，是她本人，还是诗里的她？"
 }
]