[
 {
  "id": "v01",
  "t0": 0.15,
  "t1": 2.6,
  "text": "宇宙里，很可能还有一个你。"
 },
 {
  "id": "v02",
  "t0": 2.7,
  "t1": 7.098,
  "text": "长得一样，名字一样，连此刻刷到这条视频都一样。"
 },
 {
  "id": "v03",
  "t0": 8.2,
  "t1": 10.797,
  "text": "这不是科幻，是一道数学题。"
 },
 {
  "id": "v04",
  "t0": 11.4,
  "t1": 14.9,
  "text": "一块 3×3 的像素格，只有黑白两色，"
 },
 {
  "id": "v05",
  "t0": 15,
  "t1": 17.85,
  "text": "最多只能拼出 512 种图案。"
 },
 {
  "id": "v06",
  "t0": 17.95,
  "t1": 19.9,
  "text": "拼到第 513 次，"
 },
 {
  "id": "v07",
  "t0": 20,
  "t1": 22.676,
  "text": "就一定会和前面某一次重复。"
 },
 {
  "id": "v08",
  "t0": 23.8,
  "t1": 26.4,
  "text": "把格子换成原子，道理一样。"
 },
 {
  "id": "v09",
  "t0": 26.5,
  "t1": 30.75,
  "text": "你身边这一团空间，粒子能排出的花样多得吓人，"
 },
 {
  "id": "v10",
  "t0": 30.85,
  "t1": 32.65,
  "text": "但仍然是有限的。"
 },
 {
  "id": "v11",
  "t0": 32.75,
  "t1": 35.814,
  "text": "如果宇宙无限大，物质又处处差不多，"
 },
 {
  "id": "v12",
  "t0": 36.2,
  "t1": 39.423,
  "text": "同样的排列，就一定会在某处再出现。"
 },
 {
  "id": "v13",
  "t0": 41,
  "t1": 44.75,
  "text": "物理学家泰格马克估算，最近的另一个你，"
 },
 {
  "id": "v14",
  "t0": 44.85,
  "t1": 50.5,
  "text": "距离是：1 后面跟 10^29 个零，单位是米。"
 },
 {
  "id": "v15",
  "t0": 50.6,
  "t1": 55.45,
  "text": "每毫米写一个零，光写这个数，就要 106 亿光年。"
 },
 {
  "id": "v16",
  "t0": 55.55,
  "t1": 58.25,
  "text": "但前提是，宇宙真的无限。"
 },
 {
  "id": "v17",
  "t0": 58.35,
  "t1": 60.496,
  "text": "这件事，还没人知道。"
 },
 {
  "id": "v18",
  "t0": 61,
  "t1": 63.756,
  "text": "如果真的见到他，你想问他什么？"
 }
]