[
 {
  "id": "v01",
  "t0": 0.3,
  "t1": 6.2,
  "text": "一锅黄米饭煮熟之前，他当了宰相，坐了大牢，儿孙满堂，然后老死。"
 },
 {
  "id": "v02",
  "t0": 6.3,
  "t1": 13.2,
  "text": "开元七年，邯郸道。穷书生卢生叹气：这辈子，太不得意了。我只想出将入相。"
 },
 {
  "id": "v03",
  "t0": 13.3,
  "t1": 17.991,
  "text": "老道士递给他一个青瓷枕：枕上它，你想要的，都会有。"
 },
 {
  "id": "v04",
  "t0": 19.2,
  "t1": 23.099,
  "text": "他娶了名门崔家的女儿，考中进士，官越做越大。"
 },
 {
  "id": "v05",
  "t0": 27.6,
  "t1": 31.428,
  "text": "有人眼红，一句谗言，他被贬到千里之外。"
 },
 {
  "id": "v06",
  "t0": 31.6,
  "t1": 33.8,
  "text": "他又一步步，爬了回来。"
 },
 {
  "id": "v07",
  "t0": 36,
  "t1": 40.812,
  "text": "第二次，他被诬下狱。他拔刀要自刎，妻子拦住了他。"
 },
 {
  "id": "v08",
  "t0": 42.6,
  "t1": 47.608,
  "text": "后来，他官至中书令，封燕国公，儿孙满堂，活过八十。"
 },
 {
  "id": "v09",
  "t0": 56,
  "t1": 58.533,
  "text": "原来这一生，只在一个枕头里。"
 },
 {
  "id": "v10",
  "t0": 60.6,
  "t1": 64.114,
  "text": "他醒了。店家锅里的黄米饭，还没熟。"
 },
 {
  "id": "v11",
  "t0": 67.2,
  "t1": 70.358,
  "text": "换作是你，醒来以后，还会去赶考吗？"
 }
]