 "LINES": [
  {
   "id": "v01",
   "t": 0.3,
   "zh": "一锅黄米饭煮熟之前，他当了宰相，坐了大牢，儿孙满堂，然后老死。"
  },
  {
   "id": "v02",
   "t": 6.3,
   "zh": "开元七年，邯郸道。穷书生卢生叹气：这辈子，太不得意了。我只想出将入相。"
  },
  {
   "id": "v03",
   "t": 13.3,
   "zh": "老道士递给他一个青瓷枕：枕上它，你想要的，都会有。"
  },
  {
   "id": "v04",
   "t": 19.2,
   "zh": "他娶了名门崔家的女儿，考中进士，官越做越大。"
  },
  {
   "id": "v05",
   "t": 26.4,
   "zh": "有人眼红，一句谗言，他被贬到千里之外。"
  },
  {
   "id": "v06",
   "t": 30.4,
   "zh": "他又一步步，爬了回来。"
  },
  {
   "id": "v07",
   "t": 34.8,
   "zh": "第二次，他被诬下狱。他拔刀要自刎，妻子拦住了他。"
  },
  {
   "id": "v08",
   "t": 41.4,
   "zh": "后来，他官至中书令，封燕国公，儿孙满堂，活过八十。"
  },
  {
   "id": "v09",
   "t": 50.6,
   "zh": "原来这一生，只在一个枕头里。"
  },
  {
   "id": "v10",
   "t": 55.6,
   "zh": "他醒了。店家锅里的黄米饭，还没熟。"
  },
  {
   "id": "v11",
   "t": 62.2,
   "zh": "换作是你，醒来以后，还会去赶考吗？"
  }
 ]
